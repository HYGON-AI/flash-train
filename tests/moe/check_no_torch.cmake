find_program(READELF_EXECUTABLE readelf REQUIRED)
find_program(NM_EXECUTABLE nm REQUIRED)
foreach(library IN ITEMS "${LIBRARY}")
  execute_process(COMMAND "${READELF_EXECUTABLE}" -d "${library}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE dynamic)
  if(NOT result EQUAL 0 OR dynamic MATCHES "lib(torch|c10|python)")
    message(FATAL_ERROR "External backend or framework dependency in ${library}: ${dynamic}")
  endif()
  string(REGEX MATCHALL "Shared library: \\[[^]]+\\]" dependencies "${dynamic}")
  foreach(dependency IN LISTS dependencies)
    string(REGEX REPLACE "Shared library: \\[([^]]+)\\]" "\\1" name "${dependency}")
    if(NOT name MATCHES "^lib(galaxyhip|amdhip64|roctx64|stdc\\+\\+|m|gcc_s|c|pthread|dl|rt|atomic)\\.so(\\.[0-9]+)*$"
       AND NOT name MATCHES "^ld-linux[^/]*\\.so(\\.[0-9]+)*$")
      message(FATAL_ERROR "Unexpected dependency in ${library}: ${name}")
    endif()
  endforeach()
  if(library MATCHES "\\.a$")
    set(symbol_flags -u -C)
  else()
    set(symbol_flags -D --undefined-only --demangle)
  endif()
  execute_process(COMMAND "${NM_EXECUTABLE}" ${symbol_flags} "${library}"
                  RESULT_VARIABLE result OUTPUT_VARIABLE symbols)
  if(NOT result EQUAL 0 OR symbols MATCHES "(torch|at|c10)::")
    message(FATAL_ERROR "Framework symbols in ${library}: ${symbols}")
  endif()
  if(NOT library MATCHES "\\.a$" AND symbols MATCHES "ftrain::(moe|moe_compat)::")
    message(FATAL_ERROR "Unresolved external backend symbols in ${library}: ${symbols}")
  endif()
  if(NOT library MATCHES "\\.a$")
    execute_process(COMMAND "${NM_EXECUTABLE}" -D --defined-only --demangle "${library}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE exports)
    if(NOT result EQUAL 0 OR exports MATCHES "ftrain::(moe|moe_compat)::")
      message(FATAL_ERROR "Private backend symbols exported by ${library}: ${exports}")
    endif()
  endif()
endforeach()
