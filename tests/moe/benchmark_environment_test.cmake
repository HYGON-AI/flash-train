if(NOT DEFINED BINARY OR NOT EXISTS "${BINARY}")
  message(FATAL_ERROR "MoE benchmark binary not found: ${BINARY}")
endif()

set(required_variables FTRAIN_BENCH_ROUTE FTRAIN_BENCH_SEED FTRAIN_BENCH_RANK_M)

function(check_missing_environment operation missing_variable empty)
  set(FTRAIN_BENCH_ROUTE ag_nn_ring_chunk)
  set(FTRAIN_BENCH_SEED 2026)
  set(FTRAIN_BENCH_RANK_M 64,64)
  set(environment "HIP_VISIBLE_DEVICES=" "ROCR_VISIBLE_DEVICES="
                  FTRAIN_BENCH_RANK=0 FTRAIN_BENCH_WORLD_SIZE=2
                  "FTRAIN_BENCH_RENDEZVOUS=${CMAKE_CURRENT_BINARY_DIR}")
  foreach(variable IN LISTS required_variables)
    list(APPEND unset_options "--unset=${variable}")
    if(variable STREQUAL missing_variable OR missing_variable STREQUAL "all")
      if(empty)
        list(APPEND environment "${variable}=")
      endif()
    else()
      list(APPEND environment "${variable}=${${variable}}")
    endif()
  endforeach()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${unset_options} ${environment}
                          "${BINARY}" "${operation}" bf16 128,1024,2048
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(NOT "${result}" STREQUAL "2")
    message(FATAL_ERROR "${operation}: missing=${missing_variable}, empty=${empty}: expected exit 2, got ${result}\n${output}\n${error}")
  endif()
  if(missing_variable STREQUAL "all")
    set(missing_variable FTRAIN_BENCH_ROUTE)
  endif()
  string(FIND "${error}" "missing or empty MoE benchmark environment: ${missing_variable}" diagnostic)
  if(diagnostic EQUAL -1)
    message(FATAL_ERROR "${operation}: missing configuration diagnostic for ${missing_variable}: ${error}")
  endif()
  if(NOT "${output}" STREQUAL "" OR error MATCHES "hip error")
    message(FATAL_ERROR "${operation}: configuration was checked after GPU initialization or benchmark output\n${output}\n${error}")
  endif()
endfunction()

foreach(operation IN ITEMS ag_group_gemm)
  check_missing_environment("${operation}" all FALSE)
  foreach(variable IN LISTS required_variables)
    check_missing_environment("${operation}" "${variable}" FALSE)
    check_missing_environment("${operation}" "${variable}" TRUE)
  endforeach()
endforeach()

message(STATUS "MoE benchmark environment checks passed (7 cases; no visible GPUs)")
